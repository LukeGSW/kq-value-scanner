# ============================================================================
# KQ Value Scanner · Nightly prices pipeline
# ----------------------------------------------------------------------------
# Scope: aggiornamento notturno dei prezzi + ricalcolo delle metriche tecniche
# (SMA, zScore, HV, drawdown, RS) + rigenerazione dei JSON dello screener e
# delle pagine ticker.
#
# Frequenza: Lun-Ven alle 04:00 UTC (mercati USA già chiusi + margine).
# Manuale: workflow_dispatch con `mode` (incremental|full) e `exchange`.
# ============================================================================
name: Nightly prices

on:
  schedule:
    # Martedì-Sabato 04:00 UTC (copre le chiusure Lun-Ven negli US/EU)
    - cron: "0 4 * * 2-6"
  workflow_dispatch:
    inputs:
      mode:
        description: "Fetch mode (incremental|full)"
        required: true
        default: "incremental"
        type: choice
        options:
          - incremental
          - full
      exchange:
        description: "Exchange filter (es. US, LSE, XETRA). Vuoto = tutti."
        required: false
        default: ""
        type: string

# Evita esecuzioni parallele: la pipeline scrive sullo stesso DB/JSON.
concurrency:
  group: kq-pipeline
  cancel-in-progress: false

permissions:
  contents: write   # push dei JSON rigenerati

jobs:
  prices:
    name: Fetch prices · compute tech · rebuild JSON
    runs-on: ubuntu-22.04
    timeout-minutes: 90

    env:
      EODHD_API_KEY: ${{ secrets.EODHD_API_KEY }}
      PYTHONUNBUFFERED: "1"
      TZ: "UTC"

    steps:
      - name: Checkout repo
        uses: actions/checkout@v4
        with:
          fetch-depth: 1

      - name: Setup Python 3.11
        uses: actions/setup-python@v5
        with:
          python-version: "3.11"
          cache: "pip"
          cache-dependency-path: requirements.txt

      - name: Install dependencies
        run: |
          python -m pip install --upgrade pip
          pip install -r requirements.txt

      - name: Ensure storage/universe dirs
        run: |
          mkdir -p pipeline/storage/db docs/data docs/data/tickers _restored

      # --------------------------------------------------------------
      # Restore DB condiviso con weekly-fundamentals.
      # NOME ARTIFACT FISSO: `kq-scanner-db` (UNICO tra nightly+weekly).
      # Cerca l'ultimo run di QUALSIASI workflow che l'abbia prodotto.
      # --------------------------------------------------------------
      - name: Restore DB from shared artifact (gh CLI)
        id: restore_db
        continue-on-error: true
        env:
          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
          REPO: ${{ github.repository }}
          CURRENT_RUN: ${{ github.run_id }}
        run: |
          set -u
          echo "=== Cerca ultimo run con artifact 'kq-scanner-db' su nightly+weekly ==="
          PREV_RUN_ID=""
          # Lista run di ENTRAMBI i workflow, ordinati per data decrescente
          RUN_IDS=$(
            (gh run list --workflow=nightly-prices.yml       --limit=20 --json databaseId,createdAt
             gh run list --workflow=weekly-fundamentals.yml  --limit=20 --json databaseId,createdAt) \
              | jq -s 'add | sort_by(.createdAt) | reverse | .[].databaseId'
          )
          for RID in $RUN_IDS; do
            RID=$(echo "$RID" | tr -d '"')
            if [[ "$RID" == "$CURRENT_RUN" ]]; then continue; fi
            if gh api "repos/$REPO/actions/runs/$RID/artifacts" \
                 --jq '.artifacts[] | select(.expired == false) | .name' 2>/dev/null \
                 | grep -qx "kq-scanner-db"; then
              PREV_RUN_ID="$RID"
              echo "→ Trovato run $RID con artifact 'kq-scanner-db'"
              break
            fi
          done

          if [[ -z "$PREV_RUN_ID" ]]; then
            echo "Nessun artifact 'kq-scanner-db' trovato (primo run unificato)."
            echo "restored=false" >> "$GITHUB_OUTPUT"
            exit 0
          fi

          gh run download "$PREV_RUN_ID" --name kq-scanner-db --dir ./_restored

          FOUND=$(find ./_restored -name 'kq_scanner.db' -type f | head -1)
          if [[ -n "$FOUND" ]]; then
            mv "$FOUND" pipeline/storage/db/kq_scanner.db
            echo "DB ripristinato (size: $(stat -c%s pipeline/storage/db/kq_scanner.db) bytes)"
            python - <<'PY'
          import sqlite3
          c = sqlite3.connect("pipeline/storage/db/kq_scanner.db")
          for t in ["universe","fundamentals_snapshot","computed_metrics","prices_daily"]:
              try:
                  n = c.execute(f"SELECT COUNT(*) FROM {t}").fetchone()[0]
                  print(f"  {t}: {n}")
              except Exception as e:
                  print(f"  {t}: (missing) {e}")
          PY
            echo "restored=true" >> "$GITHUB_OUTPUT"
          else
            echo "Artifact scaricato ma kq_scanner.db non trovato."
            find ./_restored -type f | head -20
            echo "restored=false" >> "$GITHUB_OUTPUT"
          fi

      # --------------------------------------------------------------
      # 1) Universe · soltanto se mancante o mode=full
      # --------------------------------------------------------------
      - name: Build universe (if missing or mode=full)
        env:
          MODE: ${{ github.event.inputs.mode || 'incremental' }}
        run: |
          if [[ "$MODE" == "full" ]] || [[ ! -f pipeline/storage/db/universe.parquet ]]; then
            echo "::group::Rebuild universe"
            python -m pipeline.fetch.fetch_universe -v
            echo "::endgroup::"
          else
            echo "Universe già presente · skip"
          fi

      # --------------------------------------------------------------
      # 1b) Init SQLite schema + import universo nel DB
      #     (genera storage/kq.sqlite se non presente e popola tabella
      #      `universe` leggendo storage/universe.parquet)
      # --------------------------------------------------------------
      - name: Init SQLite schema + load universe
        run: |
          python -m pipeline.storage.db --init --load-universe --stats

      # --------------------------------------------------------------
      # 2) Fetch prezzi
      #    mode=incremental → bulk EOD del giorno (senza flag)
      #    mode=full        → backfill storico 10Y (--backfill)
      # --------------------------------------------------------------
      - name: Fetch daily prices
        env:
          MODE: ${{ github.event.inputs.mode || 'incremental' }}
          EXCH: ${{ github.event.inputs.exchange || '' }}
        run: |
          ARGS="-v"
          if [[ "$MODE" == "full" ]]; then ARGS="$ARGS --backfill"; fi
          if [[ -n "$EXCH" ]]; then ARGS="$ARGS --exchange $EXCH"; fi
          echo "Running: python -m pipeline.fetch.fetch_prices $ARGS"
          python -m pipeline.fetch.fetch_prices $ARGS

      # --------------------------------------------------------------
      # 2b) Fetch benchmark (SPY, VUKE, EXS1, CAC, AEX, BEL20, FTSEMIB, SMI)
      #     Servono al calcolo di rs_126d in compute.technical.
      #     Non sono nell'universo → step separato.
      #     mode=full → backfill 10Y; mode=incremental → ultimi 30gg.
      # --------------------------------------------------------------
      - name: Fetch benchmark prices
        env:
          MODE: ${{ github.event.inputs.mode || 'incremental' }}
        run: |
          ARGS="-v"
          if [[ "$MODE" == "full" ]]; then ARGS="$ARGS --backfill --years 10"; fi
          echo "Running: python -m pipeline.fetch.fetch_benchmarks $ARGS"
          python -m pipeline.fetch.fetch_benchmarks $ARGS

      # --------------------------------------------------------------
      # 3) Ricalcolo metriche tecniche (SMA, zScore, HV, DD, RS)
      # --------------------------------------------------------------
      - name: Compute technical metrics
        run: |
          python -m pipeline.compute.screener -v

      # --------------------------------------------------------------
      # 4) Rigenera JSON screener + per-ticker pages
      # --------------------------------------------------------------
      - name: Rebuild screener.json
        run: |
          python -m pipeline.generate.build_screener_json \
            --output docs/data/screener.json --minify

      - name: Rebuild per-ticker JSON pages
        run: |
          python -m pipeline.generate.build_ticker_pages \
            --output-dir docs/data/tickers --minify

      # --------------------------------------------------------------
      # 5) Commit & push dei JSON aggiornati (se cambiati)
      # --------------------------------------------------------------
      - name: Commit updated JSON
        run: |
          git config user.name  "kq-bot"
          git config user.email "kq-bot@users.noreply.github.com"
          git add docs/data/screener.json docs/data/tickers/
          if git diff --cached --quiet; then
            echo "Nessun cambiamento nei JSON · nulla da committare"
            exit 0
          fi
          TS=$(date -u '+%Y-%m-%d %H:%M UTC')
          git commit -m "chore(data): nightly prices refresh · $TS"

          # Push con retry + rebase: se la main è avanzata durante il run
          # (workflow long-running), rebasiamo e riproviamo invece di fallire.
          for attempt in 1 2 3; do
            if git push; then
              echo "Push OK al tentativo $attempt"
              exit 0
            fi
            echo "Push fallito (tentativo $attempt/3) · fetch + rebase + retry"
            git fetch origin main
            git rebase origin/main || {
              echo "Rebase fallito · abort"
              git rebase --abort || true
              exit 1
            }
          done
          echo "Push fallito dopo 3 tentativi"
          exit 1

      # --------------------------------------------------------------
      # 6) Report artifacts (logs + fetch_log table dump)
      # --------------------------------------------------------------
      - name: Export fetch_log summary
        if: always()
        run: |
          python - <<'PY'
          import sqlite3, os, json, pathlib
          db = "pipeline/storage/db/kq_scanner.db"
          if not os.path.exists(db):
              print("DB missing, skip"); raise SystemExit(0)
          con = sqlite3.connect(db)
          rows = con.execute(
              "SELECT * FROM fetch_log ORDER BY ts_utc DESC LIMIT 20"
          ).fetchall()
          cols = [c[0] for c in con.execute("SELECT * FROM fetch_log LIMIT 0").description]
          out = [dict(zip(cols,r)) for r in rows]
          pathlib.Path("fetch_log_tail.json").write_text(json.dumps(out,default=str,indent=2))
          print(f"Exported {len(out)} rows")
          PY

      # Nome artifact FISSO `kq-scanner-db` — UNICO condiviso tra
      # nightly-prices e weekly-fundamentals (unica fonte di persistenza DB).
      # `overwrite: true` permette a più run di sostituire lo stesso artifact.
      - name: Upload DB artifact (shared stable name)
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: kq-scanner-db
          path: |
            fetch_log_tail.json
            pipeline/storage/db/kq_scanner.db
          retention-days: 30
          overwrite: true
          if-no-files-found: warn
